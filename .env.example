# ============================================================
# NETDOCTOR ENVIRONMENT VARIABLES
# ============================================================

# Application
APP_NAME=NetDoctor
APP_ENV=development
DEBUG=true

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/netdoctor

# Redis - optional in early development
REDIS_URL=redis://localhost:6379/0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Security
SECRET_KEY=change-this-in-production